{
  "name": "paper-guide-zotero",
  "type": "module",
  "version": "0.1.5",
  "description": "A guided paper-reading assistant for Zotero with source-linked Q&A and configurable model providers.",
  "config": {
    "addonName": "Paper Guide",
    "addonID": "paperguide@zotero-paper-guide",
    "addonRef": "paper-guide",
    "addonInstance": "PaperGuide",
    "prefsPrefix": "extensions.zotero.paperguide"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Echo-cln/zotero-paper-guide.git"
  },
  "author": "Echo-cln",
  "bugs": {
    "url": "https://github.com/Echo-cln/zotero-paper-guide/issues"
  },
  "homepage": "https://github.com/Echo-cln/zotero-paper-guide#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
